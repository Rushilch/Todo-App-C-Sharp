<UserControl x:Class="ProductivityApp.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="StickyTaskTemplate">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,10"
                    Cursor="Hand"
                    PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="TaskCard_PreviewMouseMove">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Command="{Binding DataContext.ToggleTaskCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding .}"
                                  VerticalAlignment="Top"
                                  Margin="0,2,8,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <Button Grid.Column="2"
                                Content="X"
                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding .}"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="{DynamicResource AccentTextBrush}"
                                BorderThickness="0"
                                Padding="6,2"
                                FontSize="10"
                                FontWeight="Bold"
                                Cursor="Hand"/>
                    </Grid>

                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               Margin="22,6,0,0"
                               TextWrapping="Wrap"/>

                    <Grid Margin="22,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="0,0,6,0">
                            <TextBlock Text="{Binding Category}"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="10"/>
                        </Border>
                        <Border Grid.Column="1"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="4"
                                Padding="6,3"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Priority}"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding DueDate, StringFormat='Due {0:MMM d}'}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Task Board" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="A sticky-board view grouped by priority, with completed tasks kept on the board."
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource ModernCardStyle}"
                    Margin="0,18,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8"
                             Background="{DynamicResource ContentBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrushColor}"
                             Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategoryName}"
                              Background="{DynamicResource ContentBackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource BorderBrushColor}"
                              Padding="8"
                              Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding Priorities}"
                              SelectedItem="{Binding SelectedPriorityName}"
                              Background="{DynamicResource ContentBackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource BorderBrushColor}"
                              Padding="8"
                              Margin="0,0,10,0"/>
                    <Button Grid.Column="3"
                            Content="+ Add Task"
                            Command="{Binding AddTaskCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentTextBrush}"
                            BorderThickness="0"
                            Padding="14,9"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#22F38BA8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0" AllowDrop="True" Tag="High" DragOver="TaskColumn_DragOver" Drop="TaskColumn_Drop">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="High" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding HighPriorityTasks}" ItemTemplate="{StaticResource StickyTaskTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="#22F9E2AF" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0" AllowDrop="True" Tag="Medium" DragOver="TaskColumn_DragOver" Drop="TaskColumn_Drop">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Medium" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MediumPriorityTasks}" ItemTemplate="{StaticResource StickyTaskTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="#22A6E3A1" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0" AllowDrop="True" Tag="Low" DragOver="TaskColumn_DragOver" Drop="TaskColumn_Drop">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Low" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LowPriorityTasks}" ItemTemplate="{StaticResource StickyTaskTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="3" Background="#2289B4FA" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="12" AllowDrop="True" Tag="Done" DragOver="TaskColumn_DragOver" Drop="TaskColumn_Drop">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Done" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DoneTasks}" ItemTemplate="{StaticResource StickyTaskTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Style="{StaticResource ModernCardStyle}"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Tasks" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TotalTasks}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Completed" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding CompletedTasks}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Completion Rate" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding CompletionRate, StringFormat={}{0:P0}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
