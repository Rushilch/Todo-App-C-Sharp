<UserControl x:Class="ProductivityApp.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProductivityApp.Converters">
    <UserControl.Resources>
        <conv:DateEqualsConverter x:Key="DateEqualsConverter"/>
        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.SelectedDate, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DateEqualsConverter}, ConverterParameter={Binding}}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Calendar" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Manage your events and schedule" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <Button Content="Previous" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" Command="{Binding PreviousMonthCommand}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding CurrentMonthYear}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="20,0" VerticalAlignment="Center"/>
                        <Button Content="Next" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" Command="{Binding NextMonthCommand}" Margin="12,0,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <UniformGrid Columns="7">
                            <TextBlock Text="Sun" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="4"/>
                            <TextBlock Text="Mon" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="4"/>
                            <TextBlock Text="Tue" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="4"/>
                            <TextBlock Text="Wed" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="4"/>
                            <TextBlock Text="Thu" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="4"/>
                            <TextBlock Text="Fri" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="4"/>
                            <TextBlock Text="Sat" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="4"/>
                        </UniformGrid>

                        <ItemsControl ItemsSource="{Binding CalendarDays}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DayButtonStyle}" Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Day}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Selected Day Events" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Content="Add Event" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" Click="AddEventButton_Click" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
