<UserControl x:Class="ProductivityApp.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <StackPanel Margin="20">
            <TextBlock Text="Analytics" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Track your productivity over time" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>

            <Grid Margin="0,20,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Tasks" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TotalTasksCompleted}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Pomodoros" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding PomodosCompleted}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Focus Time" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TotalFocusHours, StringFormat={}{0:0.0}h}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Daily Avg" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding DailyAverage, StringFormat={}{0:0.0}}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Daily Breakdown" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource ModernCardStyle}">
                <ItemsControl ItemsSource="{Binding DailyStats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ContentBackgroundBrush}" Padding="10" Margin="0,5,0,5" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat={}{0:MMM d}}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TasksCompleted}" Foreground="{DynamicResource SuccessBrush}" Margin="20,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PomodorosCompleted}" Foreground="{DynamicResource DangerBrush}" Margin="20,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalFocusTimeMinutes}" Foreground="{DynamicResource AccentBrush}" Margin="20,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Export Report" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource AccentTextBrush}" Command="{Binding ExportReportCommand}" Margin="0,0,10,0"/>
                <Button Content="Refresh" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
