<UserControl x:Class="ProductivityApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <StackPanel Margin="20">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Tasks Completed" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TasksCompleted}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Pomodoros Completed" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding PomodorosCompleted}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Focus Time (mins)" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding FocusTimeMinutes}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Upcoming Tasks" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,30,0,15"/>
            <Border Style="{StaticResource ModernCardStyle}">
                <ListBox ItemsSource="{Binding UpcomingTasks}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrushColor}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding DueDate, StringFormat='Due {0:MMM d, yyyy}'}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
